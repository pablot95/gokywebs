# Credenciales reales — nunca commitear. Ver config/mp-config.example.php.
config/mp-config.php
config/mp-oauth-config.php
config/wabot-config.php
wabot/data/
# track.php la crea sola, con su propio .htaccess: es de runtime
form/data/
config/arca/*.key
config/arca/*.crt
config/arca/*.csr
config/arca/ticket-*.json
# Lo que escribe el server al facturar: el registro de facturas, la facturación
# automática de las suscripciones (ajustes, estado, log) y sus locks.
config/arca/emitidas-*.json*
config/arca/facturacion-automatica*
config/arca/facturas-*/
config/arca/condiciones-iva-*.json
wabot/bot-config.json
service-account.json
demo/*
!demo/track.js
!demo/track.php
facturador/data/*
!facturador/data/.htaccess

# Config local de Claude Code (rutas absolutas de esta máquina, no del proyecto)
.claude/

# Topes anti-spam de err/log.php (se regeneran solos)
err/data/*
!err/data/.htaccess
