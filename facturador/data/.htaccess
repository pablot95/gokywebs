# Bloquea el acceso HTTP directo a esta carpeta (certificados y datos de facturación de cada usuario).
# Solo se puede leer via require/include desde PHP del mismo servidor.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
