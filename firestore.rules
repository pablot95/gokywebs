rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == "pablo.travi95@gmail.com";
    }

    match /clientes/{doc}      { allow read, write: if isAdmin(); }
    // Gasto en publicidad por semana, cargado a mano en la pestaña Inversión
    // (26-sep-2026): un doc por semana, id = el domingo ("YYYY-MM-DD").
    match /gastoPublicidad/{doc} { allow read, write: if isAdmin(); }
    match /propuestas/{doc}    {
      allow create: if true;           // formulario /form escribe sin login
      allow read, delete: if isAdmin();
      // El form (sin login) confirma su muestra o reenvía tras "volver a revisar":
      // solo puede tocar campos del propio formulario + el flag de confirmación,
      // nunca los campos internos del admin (notas, contactado, bocetoHecho,
      // presentada, createdBy…) ni borrar. Update amplio sigue siendo solo admin.
      allow update: if isAdmin() || request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'confirmoMuestra', 'confirmadoAt', 'updatedAt',
        'to_name', 'nombre', 'telefono', 'negocio_rubro', 'nombre_negocio', 'rubro',
        'instagram', 'ciudad_zona', 'cant_cursos', 'objetivos', 'objetivos_texto',
        'tipo_pagina', 'tipo_web', 'que_incluye', 'precio_total', 'precio_sena',
        'precio_saldo', 'adicionales', 'color_fondos', 'color_principal',
        'color_secundario', 'colores', 'tipografias', 'fecha', 'logoUrl', 'logoNombre',
        'tipoDetectado', 'tipoDetectadoLabel', 'precioTotal', 'sena', 'saldo', 'presupuestoId',
        // Modelo primer pago + plan mensual (10-sep-2026). Los viejos se siguen
        // escribiendo (sena = primer pago, saldo = 0) para que el admin no rompa.
        'primerPago', 'mensualidad',
        // La forma de pago que el cliente eligió por WhatsApp, si la eligió
        // después de que se creara el boceto (wabot, 15-sep-2026).
        // Marca esta ficha como prospecto: el cliente vio el precio y afirmó
        // una forma de pago, el bot dejó de responder (wabot, 15/16-sep-2026).
        'modalidad', 'esProspecto', 'prospectoAt', 'modelosElegidos'
      ]) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['esProspecto'])
              || request.resource.data.esProspecto == true)
         && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['modalidad'])
              || request.resource.data.modalidad in ['unico', 'mensual', 'propia'])
         && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['modelosElegidos'])
              || (request.resource.data.modelosElegidos is string
                  && request.resource.data.modelosElegidos.size() <= 500));
    }
    match /presupuestos/{doc}  {
      allow create: if true;           // visitantes guardan su lead sin login
      allow read, update, delete: if isAdmin();
    }
    match /presupuesto_funnel/{doc} {
      // Un doc por sesión de /presupuesto/, escrito con merge a medida que
      // avanza (paso 1 → paso 2 → paso 3 → precio → muestra → confirmó).
      // Sin login: solo puede tocar sus propios campos de progreso, nunca
      // agregar campos arbitrarios.
      allow create: if true;
      // ⚠️ hasOnly: si /presupuesto/script.js manda UN campo que no esté acá,
      // Firestore rechaza la escritura entera y se pierde ese hito del embudo.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'step1At', 'step2At', 'step3At', 'precioAt', 'muestraAt', 'confirmoAt',
        'customObjAt',
        'phone', 'siteType', 'totalPrice', 'primerPago', 'mensualidad',
        'precioUnico', 'sena', 'saldo', 'modalidad', 'updatedAt'
      ]);
      allow read, delete: if isAdmin();
    }
    match /mantenimiento/{doc} {
      allow create: if true;           // el webhook de MP (sin login) carga suscriptores
      allow read, update, delete: if isAdmin();   // solo Pablo lista/edita/elimina
    }
    // Errores de las webs de los clientes (pestaña Errores del admin). Los escribe
    // err/log.php sin login (mismo patrón que el webhook de MP): solo CREAR, con
    // campos y largos acotados. Leer y borrar es solo del admin.
    match /errores_web/{doc} {
      allow create: if request.resource.data.keys().hasOnly(['site', 'tipo', 'nivel', 'msg', 'src', 'line', 'col', 'stack', 'url', 'ua', 'hash', 'at'])
                    && request.resource.data.site is string && request.resource.data.site.size() <= 80
                    && request.resource.data.tipo in ['error', 'promesa', 'recurso', 'fetch']
                    && request.resource.data.nivel in ['alto', 'bajo']
                    && request.resource.data.msg is string && request.resource.data.msg.size() <= 400
                    && request.resource.data.src is string && request.resource.data.src.size() <= 300
                    && request.resource.data.stack is string && request.resource.data.stack.size() <= 1200
                    && request.resource.data.url is string && request.resource.data.url.size() <= 200
                    && request.resource.data.ua is string && request.resource.data.ua.size() <= 160
                    && request.resource.data.hash is string && request.resource.data.hash.size() <= 16
                    && request.resource.data.line is int && request.resource.data.col is int
                    && request.resource.data.at is timestamp;
      allow read, delete: if isAdmin();
    }
    // Señal de vida de cada web (un doc por dominio, id = dominio). La escribe err/log.php
    // una vez por día sin login; sirve para que la web aparezca en el panel aunque no falle.
    match /errores_pings/{doc} {
      allow create, update: if request.resource.data.keys().hasOnly(['dominio', 'at'])
                            && request.resource.data.dominio is string && request.resource.data.dominio == doc
                            && doc.size() <= 80
                            && request.resource.data.at is timestamp;
      allow read, delete: if isAdmin();
    }
    // Por web: desde cuándo están "resueltos" sus errores y si está oculta (botones del admin).
    match /errores_sitios/{doc} { allow read, write: if isAdmin(); }
    match /completados/{doc}   { allow read, write: if isAdmin(); }
    match /tareas/{doc}        { allow read, write: if isAdmin(); }
    match /resenas/{doc} {
      // La barra de devolución de cada demo escribe sin login (ver snippets_canonicos_demos §9).
      allow create: if request.resource.data.keys().hasOnly(['slug', 'negocio', 'rating', 'colores', 'contenido', 'otros', 'url', 'createdAt', 'visto'])
                    && request.resource.data.slug is string
                    && (!('colores' in request.resource.data) || (request.resource.data.colores is string && request.resource.data.colores.size() <= 300))
                    && (!('contenido' in request.resource.data) || (request.resource.data.contenido is string && request.resource.data.contenido.size() <= 300))
                    && (!('otros' in request.resource.data) || (request.resource.data.otros is string && request.resource.data.otros.size() <= 300));
      allow read, update, delete: if isAdmin();
    }
  }
}
