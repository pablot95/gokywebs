# Evita que el repositorio git (si queda deployado) sea navegable públicamente.
RedirectMatch 404 /\.git

# Los .md son documentos internos (auditorías del wabot con nombres de clientes,
# CLOUDFLARE.md, los BRIEFING.md de las demos) y no se sirven por HTTP (26-sep-2026).
RedirectMatch 404 \.[mM][dD]$

# Hostinger usa un sistema de archivos sensible a mayúsculas. Si una URL llega
# con otra combinación de mayúsculas/minúsculas, el router busca el archivo o
# directorio real y redirige a su URL canónica. Las rutas correctas no pasan por
# PHP, por lo que no se agrega trabajo extra a las visitas normales.
<IfModule mod_rewrite.c>
RewriteEngine On

# Las páginas del plan mensual se mudaron a /planmensual (Pablo, 19-sep-2026):
# los links viejos que ya se mandaron por WhatsApp redirigen a los nuevos. Van
# antes del case-router, que no las encontraría. /mantenimiento/api/ (el webhook
# de suscripciones de Mercado Pago) sigue en su lugar y no se redirige.
RewriteRule ^mantenimiento/?$ /planmensual/ [R=301,L]
RewriteRule ^mantenimiento/index\.html$ /planmensual/ [R=301,L]
RewriteRule ^mantenimientomensual(/.*)?$ /planmensual/sitioprofesional/ [R=301,L]
RewriteRule ^mantenimientoweb(/.*)?$ /planmensual/tienda/ [R=301,L]

# El plan mensual bajó de $19.900 / $29.900 a $19.000 / $29.000 (Pablo, 2-oct-2026,
# mismos links de Mercado Pago): las páginas se renombraron y los links que el bot
# ya mandó con el monto viejo llevan a las nuevas.
RewriteRule ^pago/mensual19900(/.*)?$ /pago/mensual20000/ [R=301,L]
RewriteRule ^pago/mensual29900(/.*)?$ /pago/mensual30000/ [R=301,L]
RewriteRule ^planmensual/19900(/.*)?$ /planmensual/20000/ [R=301,L]
RewriteRule ^planmensual/29900(/.*)?$ /planmensual/30000/ [R=301,L]

# El anual de tienda/cursos/inmobiliaria y los pagos únicos bajaron el mismo día
# ($199.000 → $190.000, $299.000 → $290.000; el anual del sitio sigue en $149.000).
RewriteRule ^pago/anual199(/.*)?$ /pago/anual190/ [R=301,L]
RewriteRule ^pago/unico199(/.*)?$ /pago/unico220/ [R=301,L]
RewriteRule ^pago/unico299(/.*)?$ /pago/unico330/ [R=301,L]

# 3-oct-2026 (Pablo): mensual $20.000 / $30.000 (mismos links de Mercado Pago),
# anual $140.000 / $220.000 y pago único $220.000 / $330.000. Las páginas se
# renombraron; las de arriba ya apuntan directo a las nuevas, sin cadena.
RewriteRule ^pago/mensual19000(/.*)?$ /pago/mensual20000/ [R=301,L]
RewriteRule ^pago/mensual29000(/.*)?$ /pago/mensual30000/ [R=301,L]
RewriteRule ^pago/anual149(/.*)?$ /pago/anual120/ [R=301,L]
RewriteRule ^pago/unico190(/.*)?$ /pago/unico220/ [R=301,L]
RewriteRule ^pago/unico290(/.*)?$ /pago/unico330/ [R=301,L]
RewriteRule ^planmensual/19000(/.*)?$ /planmensual/20000/ [R=301,L]
RewriteRule ^planmensual/29000(/.*)?$ /planmensual/30000/ [R=301,L]

# 5-oct-2026 (Pablo): el mensual subió a $22.000 / $32.000 y el 6-oct volvió
# a $20.000 / $30.000. El enlace viejo de $22.000 lleva al plan de $20.000.
# /pago/mensual32000 vuelve a tener una página propia desde el 7-oct-2026.
RewriteRule ^pago/mensual22000(/.*)?$ /pago/mensual20000/ [R=301,L]
RewriteRule ^planmensual/22000(/.*)?$ /planmensual/20000/ [R=301,L]
RewriteRule ^planmensual/32000(/.*)?$ /planmensual/30000/ [R=301,L]
# Las páginas de fines de septiembre (19 al 29-sep) seguían online con sus montos
# de entonces: se borraron y sus links llevan a la de hoy del mismo tipo.
# mensual20, 25 y 30 eran del sitio profesional; mensual35 y 40, del resto.
RewriteRule ^pago/mensual(20|25|30)(/.*)?$ /pago/mensual20000/ [R=301,L]
RewriteRule ^pago/mensual(35|40)(/.*)?$ /pago/mensual30000/ [R=301,L]
RewriteRule ^pago/anual180(/.*)?$ /pago/anual120/ [R=301,L]
RewriteRule ^pago/anual250(/.*)?$ /pago/anual190/ [R=301,L]
RewriteRule ^pago/unico240(/.*)?$ /pago/unico220/ [R=301,L]
RewriteRule ^pago/unico360(/.*)?$ /pago/unico330/ [R=301,L]

# 7-oct-2026 (Pablo): el anual general es $120.000 / $190.000. El plan de
# $220.000 tiene de nuevo su propia página para la propuesta mensual de $32.000.
RewriteRule ^pago/anual140(/.*)?$ /pago/anual120/ [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ case-router.php [L,QSA]
</IfModule>

# Cuando el módulo está disponible, también corrige diferencias de mayúsculas
# dentro de nombres de archivos estáticos (imágenes, CSS y JavaScript).
<IfModule mod_speling.c>
CheckSpelling On
CheckCaseOnly On
</IfModule>
