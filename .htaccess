# Evita que el repositorio git (si queda deployado) sea navegable públicamente.
RedirectMatch 404 /\.git

# Los .md son documentos internos (auditorías del wabot con nombres de clientes,
# CLOUDFLARE.md, los BRIEFING.md de las demos) y no se sirven por HTTP (26-sep-2026).
RedirectMatch 404 \.[mM][dD]$

# Hostinger usa un sistema de archivos sensible a mayúsculas. Si una URL llega
# con otra combinación de mayúsculas/minúsculas, el router busca el archivo o
# directorio real y redirige a su URL canónica. Las rutas correctas no pasan por
# PHP, por lo que no se agrega trabajo extra a las visitas normales.
<IfModule mod_rewrite.c>
RewriteEngine On

# Las páginas del plan mensual se mudaron a /planmensual (Pablo, 19-sep-2026):
# los links viejos que ya se mandaron por WhatsApp redirigen a los nuevos. Van
# antes del case-router, que no las encontraría. /mantenimiento/api/ (el webhook
# de suscripciones de Mercado Pago) sigue en su lugar y no se redirige.
RewriteRule ^mantenimiento/?$ /planmensual/ [R=301,L]
RewriteRule ^mantenimiento/index\.html$ /planmensual/ [R=301,L]
RewriteRule ^mantenimientomensual(/.*)?$ /planmensual/sitioprofesional/ [R=301,L]
RewriteRule ^mantenimientoweb(/.*)?$ /planmensual/tienda/ [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ case-router.php [L,QSA]
</IfModule>

# Cuando el módulo está disponible, también corrige diferencias de mayúsculas
# dentro de nombres de archivos estáticos (imágenes, CSS y JavaScript).
<IfModule mod_speling.c>
CheckSpelling On
CheckCaseOnly On
</IfModule>
